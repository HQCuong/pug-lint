{
  "name": "pug-lint-parser",
  "version": "0.1.1",
  "description": "Concrete syntax tree parser for Pug templates",
  "license": "MIT",
  "author": "HQCuong",
  "homepage": "https://pug-lint.dev/parser/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HQCuong/pug-lint.git",
    "directory": "packages/pug-parser"
  },
  "bugs": "https://github.com/HQCuong/pug-lint/issues",
  "keywords": [
    "pug",
    "jade",
    "parser",
    "cst",
    "syntax-tree"
  ],
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "exports": {
