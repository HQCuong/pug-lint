{
  "name": "eslint-plugin-pug-vue",
  "version": "0.1.0",
  "description": "ESLint lint and format rules for <template lang=\"pug\"> in Vue SFCs",
  "license": "MIT",
  "author": "HQCuong",
  "homepage": "https://pug-lint.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HQCuong/pug-lint.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": "https://github.com/HQCuong/pug-lint/issues",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "vue",
    "pug",
    "jade",
    "lint",
    "format"
  ],
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokenizer": "./dist/tokenizer.cjs"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "compat": "pnpm -w run build && node tools/compat/run.ts",
    "compat:check": "pnpm -w run build && node tools/compat/run.ts --check",
    "docs:gen": "pnpm -w run build && node tools/docs/rules-table.ts",
    "docs:check": "pnpm -w run build && node tools/docs/rules-table.ts --check"
  },
  "dependencies": {
    "pug-lint-parser": "workspace:*"
  },
  "peerDependencies": {
    "eslint": "^9.15.0 || ^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "vue-eslint-parser": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "eslint9": "npm:eslint@^9.15.0",
    "pug": "^3.0.4",
    "vue-eslint-parser": "^10.4.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
